{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Skybatan/x-neighbours/schemas/version.schema.json",
  "title": "X Neighbours release pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "released_at",
    "min_compatible_version",
    "repo",
    "global_path",
    "source_commit",
    "changelog"
  ],
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "released_at": {"type": "string"},
    "min_compatible_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "repo": {"type": "string"},
    "global_path": {"const": "global/neighbours.global.neighbours"},
    "source_commit": {"type": "string"},
    "changelog": {"type": "string"},
    "release_notes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "maxLength": 180}
    }
  }
}
